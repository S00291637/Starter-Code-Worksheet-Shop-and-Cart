<article class="product-card">
  <img src="{{image}}" alt="{{alt}}" width="300">
  <h2><a href="/product/{{id}}">{{name}}</a></h2>
  <p>Product ID: {{id}}</p>
  <h2>Category: {{category}}</h2>
  {{!-- note euro is a helper function that formats the price as a euro currency string --}}
  <p class="price">Price: {{euro price}}</p>
  <button type="button" data-add-to-cart="{{id}}">Add to cart</button>
  <p data-cart-message aria-live="polite"></p>
</article>